  "tool_stack": {
    "note": "Owner's choice (2026-11-17): open-source apps instead of paid SaaS. Most run on the OWNER's computer, not in the cloud session; agents prepare inputs and the owner runs the app, then drops outputs in company/inbox/.",
    "voice": {
      "tool": "Voicebox (jamiepine/voicebox) / Kokoro engine",
      "repo": "https://github.com/jamiepine/voicebox",
      "license": "AGPL-3.0",
      "replaces": "ElevenLabs",
      "where": "owner computer",
      "used_by": [
        "recording-producer"
      ],
      "caveat": "Clone only the owner's own voice or use built-in voices. Don't clone ElevenLabs voices (e.g. Laura) or any real person without consent."
    },
    "screen_recording": {
      "tool": "Cap",
      "repo": "https://github.com/CapSoftware/cap",
      "license": "AGPL-3.0",
      "replaces": "Loom / paid recorders",
      "where": "owner computer (macOS + web; Windows/Linux reported in development)",
      "used_by": [
        "recording-producer",
        "video-editor"
      ]
    },
    "transcription": {
      "tool": "OpenWhispr",
      "repo": "https://github.com/openwhispr/openwhispr",
      "license": "MIT (per third-party listing)",
      "replaces": "Descript transcription",
      "where": "owner computer, local Whisper",
      "used_by": [
        "captions"
      ]
    },
    "image_video_generation": {
      "tool": "Open Generative AI",
      "repo": "https://github.com/Anil-matcha/Open-Generative-AI",
      "license": "MIT",
      "replaces": "Higgsfield, Canva AI, Figma AI",
      "where": "owner computer or self-hosted",
      "used_by": [
        "thumbnail-designer"
      ],
      "caveat": "The app is free but most models run through a paid API key (Muapi); cost still needs owner approval."
    },
    "seo": {
      "tool": "OpenSEO",
      "repo": "https://github.com/every-app/open-seo",
      "license": "MIT",
      "replaces": "vidIQ keyword research, Ahrefs, Semrush",
      "where": "self-hosted or managed (~$10/month)",
      "used_by": [
        "growth-analyst",
        "trend-hunter-search"
      ],
      "caveat": "Self-hosting needs a pay-as-you-go DataForSEO API key."
    },
    "community_inbox": {
