# Copy this file to ".env" and fill in only what you use.
# Never commit .env (it is in .gitignore).

# Needed for Arabic voices with ElevenLabs (default for "ar")
ELEVENLABS_API_KEY=

# Only if you set llm.provider: anthropic_api in config/settings.yaml
ANTHROPIC_API_KEY=

# Only if you set images.provider: gemini in config/settings.yaml
GEMINI_API_KEY=
