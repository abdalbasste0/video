# ===== Claude (research, script writing, fact-checking, review) =====
ANTHROPIC_API_KEY=

# ===== ElevenLabs (voice-over) =====
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # The ID of an English voice from your ElevenLabs account (Voice Library → Use → Copy ID)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ===== Stock media (videos and images) =====
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ===== Telegram (asking the owner for approval and sending commands) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ===== YouTube (publishing after approval only) =====
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ===== TikTok (Content Posting API) =====
# Until TikTok approves your app, publishing is limited to private posts (SELF_ONLY)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY      # after the app is approved: PUBLIC_TO_EVERYONE

# ===== Instagram Reels (Instagram Graph API — Business or Creator account) =====
IG_USER_ID=
IG_ACCESS_TOKEN=              # long-lived token with instagram_content_publish permission
IG_GRAPH_VERSION=v21.0

# ===== Publishing =====
FACTORY_PLATFORMS=youtube,tiktok,instagram
YOUTUBE_PRIVACY=public        # public | unlisted | private

# ===== The private app =====
APP_PORT=8765                 # the app opens at http://127.0.0.1:8765 (on your computer only)

# ===== General settings =====
FACTORY_TIMEZONE=Africa/Cairo
FACTORY_LANGUAGE=en          # video language (narration + subtitles + title): en = English
FACTORY_FORMAT=landscape      # landscape = 1920x1080 | vertical = 1080x1920 (Shorts)
FACTORY_DRY_RUN=0             # 1 = test run with no paid API calls
