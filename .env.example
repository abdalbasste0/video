# توكن بوت ديسكورد (من https://discord.com/developers/applications)
DISCORD_TOKEN=

# معرف سيرفر ديسكورد (اختياري، يجعل الأوامر تظهر فوراً في هذا السيرفر)
DISCORD_GUILD_ID=

# معرفات المستخدمين المسموح لهم بإعطاء الأوامر (مفصولة بفاصلة) — إلزامي
ALLOWED_USER_IDS=

# المنطقة الزمنية لأوقات الجدولة
TIMEZONE=Asia/Riyadh

# ملف بيانات OAuth من Google Cloud
GOOGLE_CLIENT_SECRETS=client_secret.json

# مجلد حفظ توكنات القنوات
TOKENS_DIR=tokens

# أقصى حجم لتحميل فيديو من رابط (ميغابايت)
MAX_DOWNLOAD_MB=2048
